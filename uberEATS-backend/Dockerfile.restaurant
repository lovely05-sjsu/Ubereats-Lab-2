# Use Node.js LTS version
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose restaurant service port
EXPOSE 2002

# Set environment variables
ENV NODE_ENV=production
ENV PORT=2002
ENV SERVICE_TYPE=restaurant

# Start the restaurant service
CMD ["node", "services/restaurant.service.js"] 